# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Google Cloud Storage (only the audio recordings live in GCP; everything
# else in this app runs locally) ---
GCP_PROJECT_ID=careful-maxim-505407-a3
GCS_BUCKET_NAME=csdcallaudio
GCS_PREFIX=recordings/

# Path to a service-account JSON key with "Storage Object Viewer" role. Leave
# unset to fall back to `gcloud auth application-default login` credentials
# on this machine.
GOOGLE_APPLICATION_CREDENTIALS=

# --- Gemini Developer API (transcription + KPI/sentiment analysis in one call) ---
# Get a key from Google AI Studio (this is the plain API-key Gemini API, not
# Vertex AI / GCP project auth). Audio bytes are downloaded from GCS here and
# sent to Gemini inline.
GEMINI_API_KEY=
# Flash-Lite: cheapest/fastest tier. Bump to gemini-2.5-flash or -pro only if
# accuracy on noisy call-center audio isn't good enough.
GEMINI_MODEL=gemini-2.5-flash-lite

# --- Postgres (local instance) ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/csd_call_analysis

# --- CORS (Vite dev server) ---
CORS_ALLOW_ORIGINS=["http://localhost:5173"]
