# Copy this file to .env and fill in real values. Never commit the real .env
# (backend/.gitignore already excludes it).
#
# Loaded by app/config.py, which resolves .env next to this file — so it works
# whether you start uvicorn from backend/ or from the repo root. Values are
# read into the Settings object AND exported to the process environment, the
# latter being what lets GOOGLE_APPLICATION_CREDENTIALS below reach Google's
# auth library. A variable already set in your real shell environment wins
# over the value here.

# --- Google Cloud Storage (only the audio recordings live in GCP; everything
# else in this app runs locally) ---
GCP_PROJECT_ID=careful-maxim-505407-a3
GCS_BUCKET_NAME=csdcallaudio
GCS_PREFIX=recordings/

# Path to a service-account JSON key with "Storage Object Viewer" role. Leave
# unset to fall back to `gcloud auth application-default login` credentials
# on this machine.
GOOGLE_APPLICATION_CREDENTIALS=

# --- Gemini Developer API ---
# Get a key from Google AI Studio (this is the plain API-key Gemini API, not
# Vertex AI / GCP project auth).
GEMINI_API_KEY=
# Two tiers — see docs/pipeline.md. TRANSCRIPTION is the one node that reads
# audio (once per recording, checkpointed); EXTRACTION is every KPI node,
# reasoning over the transcript text only. Only bump TRANSCRIPTION if accuracy
# on noisy call-center audio isn't good enough — it's the expensive one.
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-flash
GEMINI_EXTRACTION_MODEL=gemini-3.5-flash-lite
# Deprecated: overrides GEMINI_EXTRACTION_MODEL if set, for old .env files
# from before the two-tier split. Leave unset on a new setup.
# GEMINI_MODEL=

# --- Cost / throughput controls ---
# Objects smaller than this are marked rejected/corrupted by the prescreen
# without being downloaded or sent to Gemini (your bucket has several 288-byte
# objects). Set to 0 to disable the gate.
MIN_AUDIO_BYTES=2048
# Calls analyzed in parallel. 1 = strict per-call category convergence.
ANALYSIS_CONCURRENCY=4
# Retries for transient model errors (429/503), so a blip doesn't force a full
# re-download + re-send on the next run.
ANALYSIS_MAX_RETRIES=3
# Spend guard: recordings sent to Gemini per run of the pipeline (per click of
# "Run Analysis"). The bucket holds ~100 recordings, so an uncapped default
# would be a surprising bill from one stray click. Each click picks up where
# the last stopped. Prescreened-out objects are free and don't count against it.
# Set to 0 to process the whole backlog in one run.
PIPELINE_RUN_LIMIT=5

# --- Postgres (local instance) ---
# Fill in the user/password for YOUR local Postgres. Special characters
# (@ : / # % etc.) are fine here and need no escaping — do NOT wrap the value
# in quotes.
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=csd_call_analysis

# Optional: a full connection string. If set, it overrides the five fields
# above. Only needed for a hosted database that hands you one ready-made.
# DATABASE_URL=

# --- CORS (Vite dev server) ---
CORS_ALLOW_ORIGINS=["http://localhost:5173"]
